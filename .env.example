# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase ────────────────────────────────────────────
# Safe to expose in browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (Resend) ───────────────────────────────────────
# Server-only
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@nasab.org

# ── OCR (Google Cloud Vision) ───────────────────────────
# Server-only
GOOGLE_CLOUD_VISION_KEY=your-gcp-api-key
# Or use a service account JSON file path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Rate Limiting (Upstash Redis) ────────────────────────
# Server-only — for /api/v1/ public rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
