# Normalise line endings to LF on commit (prevents CRLF issues on Windows)
* text=auto eol=lf

# Explicitly declare text files
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env*   text eol=lf

# Shell scripts must stay LF (not CRLF) for execution
.claude/hooks/*.sh  text eol=lf

# Binary files — no diffing or line-ending conversion
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary

# Treat Arabic/Urdu JSON as UTF-8 text (critical for correct encoding)
messages/*.json  text eol=lf working-tree-encoding=UTF-8
