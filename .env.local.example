# ─── Supabase ──────────────────────────────────────────────────────────────────
# Copy from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App URL ───────────────────────────────────────────────────────────────────
# Used for OAuth redirects and metadataBase
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@nasab.org

# ─── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Only required for Phase 5 (Public API)
# Get credentials at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ─── Google Cloud Vision (OCR) ─────────────────────────────────────────────────
# Only required for Phase 2 (Urdu PDF digitisation)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_CREDENTIALS={"type":"service_account",...}  # JSON string of service account key
